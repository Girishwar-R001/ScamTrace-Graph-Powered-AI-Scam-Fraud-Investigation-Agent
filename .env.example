# ==============================================================================
# ScamTrace Environment Configuration
# ==============================================================================

# LLM Provider Configuration (Google Gemini recommended)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional fallback keys:
OPENAI_API_KEY=
GROQ_API_KEY=

# FalkorDB Database Connection
# If left as localhost:6379 without a running FalkorDB instance,
# ScamTrace will automatically engage its high-fidelity in-memory FalkorDB graph engine.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH_NAME=scamtrace

# Application Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
